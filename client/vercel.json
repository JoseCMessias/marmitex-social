{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/prototipo",
      "destination": "/prototipo.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://server-d27r.vercel.app/api/$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "https://server-d27r.vercel.app/uploads/$1"
    }
  ]
}
